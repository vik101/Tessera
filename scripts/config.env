# Tessera build settings. Edit, then run ./scripts/build-app.sh.
# Values written as "${NAME:-…}" can also come from the environment (the CI release job uses this).

APP_NAME="Tessera"
BUNDLE_ID="com.vikram.Tessera"
VERSION="3.0.0"
BUILD="11"
MIN_MACOS="15.0"
COPYRIGHT="© 2026 Vikram"
REPO="vik101/Tessera"

# Updates (Sparkle). The app updates itself only when both are set.
# Make the keys once with ./scripts/setup-release-keys.sh (it stores the public key as a GitHub variable).
SPARKLE_FEED_URL="${SPARKLE_FEED_URL:-https://github.com/vik101/Tessera/releases/latest/download/appcast.xml}"
SPARKLE_PUBLIC_KEY="${SPARKLE_PUBLIC_KEY:-}"

# Signing. Empty = use a "Developer ID Application" or "Apple Development" certificate, or the
# "Tessera Signing" certificate made by setup-release-keys.sh, if this Mac has one; else sign ad-hoc
# (macOS then asks for Accessibility again after each update).
SIGN_IDENTITY="${SIGN_IDENTITY:-}"
# For notarized releases on your Mac: a profile saved with `xcrun notarytool store-credentials`.
NOTARY_PROFILE="${NOTARY_PROFILE:-}"

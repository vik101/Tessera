# Tessera build settings. Edit, then run ./scripts/build-app.sh.

APP_NAME="Tessera"
BUNDLE_ID="com.vikram.Tessera"
VERSION="2.4.0"
BUILD="8"
MIN_MACOS="15.0"
COPYRIGHT="© 2026 Vikram"

# Signing. Empty = use a "Developer ID Application" or "Apple Development" certificate
# if this Mac has one, else sign ad-hoc (macOS then asks for Accessibility again after each update).
SIGN_IDENTITY=""
# For notarized releases: a profile saved with `xcrun notarytool store-credentials`.
NOTARY_PROFILE=""

# Tessera build settings.
# Edit these, then run ./scripts/build-app.sh. Empty values switch a feature off.

APP_NAME="Tessera"
BUNDLE_ID="com.vikram.Tessera"
VERSION="1.0.0"
BUILD="1"
MIN_MACOS="15.0"
COPYRIGHT="© 2026 Vikram"

# Links shown in Settings › About. Leave empty to hide.
WEBSITE_URL=""
DOCS_URL=""
SUPPORT_EMAIL=""

# Licensing. Leave CHECKOUT_URL or LICENSE_API empty to ship fully unlocked.
# Dodo Payments: LICENSE_API="https://live.dodopayments.com" (test: https://test.dodopayments.com)
CHECKOUT_URL=""
LICENSE_API=""
TRIAL_DAYS="2"

# Updates (Sparkle). Leave empty to turn updates off.
# Make keys once with: .build/artifacts/sparkle/Sparkle/bin/generate_keys
SPARKLE_FEED_URL=""
SPARKLE_PUBLIC_KEY=""

# Signing. Empty = pick "Developer ID Application" or "Apple Development" automatically,
# else ad-hoc (you'd need to re-allow Accessibility after every build).
SIGN_IDENTITY=""
# For notarized releases: a profile saved with `xcrun notarytool store-credentials`.
NOTARY_PROFILE=""

    "Hold ⌘ and drag a window onto another to swap them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ y arrastra una ventana sobre otra para intercambiarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ を押しながらウインドウを別のウインドウにドラッグすると入れ替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘을 누른 채 윈도우를 다른 윈도우로 드래그하면 서로 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 将窗口拖到另一个窗口上即可交换。"
          }
        }
      }
    },
    "Hold ⌘ and drag a window onto another, or use the arrow keys.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ y arrastra una ventana sobre otra, o usa las flechas."

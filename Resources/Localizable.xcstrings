        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ を押しながらウインドウを別のウインドウへドラッグするか、矢印キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘을 누른 채 윈도우를 다른 윈도우로 드래그하거나 화살표 키를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

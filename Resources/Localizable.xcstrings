    "One window on a plain background, for sharing or presenting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana sobre un fondo liso, para compartir o presentar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無地の背景にウインドウを1つだけ。共有やプレゼン向け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단색 배경 위에 윈도우 하나. 공유나 발표용."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯色背景上只有一个窗口，适合共享或演示。"
          }
        }
      }
    },
    "Only numbers are stored, on this Mac. Never window titles or app names.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan números, en este Mac. Nunca títulos de ventanas ni nombres de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに数値だけを保存します。ウインドウのタイトルやアプリ名は保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 숫자만 저장합니다. 윈도우 제목이나 앱 이름은 저장하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在这台 Mac 上保存数字，绝不保存窗口标题或应用名称。"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "Open a window and it takes a tile. Close one and the rest fill the space. No dragging, no resizing, no layouts to set up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una ventana y ocupa un mosaico. Cierra una y las demás llenan el espacio. Sin arrastrar, sin redimensionar, sin disposiciones que configurar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを開けばタイルに収まり、閉じれば残りが隙間を埋めます。ドラッグもサイズ調整も、レイアウトの設定も不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 열면 타일에 자리 잡고, 닫으면 나머지가 빈 곳을 채웁니다. 드래그도, 크기 조절도, 레이아웃 설정도 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开窗口即占据一格；关闭一个，其余窗口会填满空间。无需拖移、调整大小或设置布局。"
          }
        }
      }
    },
    "Open at login": {

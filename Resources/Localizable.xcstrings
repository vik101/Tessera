            "value": "上"
          }
        }
      }
    },
    "Turn Off the Other": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la otra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方をオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 것 끄기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭另一个"
          }
        }
      }
    },
    "Turn on %@ in the list, then come back here. If it's already on but nothing happens, remove it with the − button and add it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa %@ en la lista y vuelve aquí. Si ya está activado pero no pasa nada, quítalo con el botón − y vuelve a añadirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストで %@ をオンにしてから、ここに戻ってください。すでにオンなのに何も起きない場合は、− ボタンで削除してから追加し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 %@을(를) 켠 다음 여기로 돌아오세요. 이미 켜져 있는데 아무 일도 없다면 − 버튼으로 제거한 뒤 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中打开 %@，然后回到这里。如果已经打开却没有反应，请用 − 按钮移除后重新添加。"
          }
        }
      }
    },

            "value": "此屏幕上的窗口"
          }
        }
      }
    },
    "Windows per screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas por pantalla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面あたりのウインドウ数"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면당 윈도우 수"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每块屏幕的窗口数"
          }
        }
      }
    },
    "Windows place themselves as they open. Closing one lets the rest fill the space.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se colocan solas al abrirse. Al cerrar una, las demás llenan el espacio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは開くと自動で配置されます。1つ閉じると、残りが隙間を埋めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우는 열리면서 알아서 자리를 잡습니다. 하나를 닫으면 나머지가 빈 곳을 채웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口打开时会自动就位。关闭一个后，其余窗口会填满空间。"
          }
        }
      }
    },
    "Windows rearranged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas reorganizadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを並べ直しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 다시 정리했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口已重新排列。"
          }
        }
      }
    },
    "Windows that arrange themselves": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas que se ordenan solas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとりでに整うウインドウ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알아서 정리되는 윈도우"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会自己排好的窗口"
          }
        }
      }
    },
    "Windows tile themselves as they open, in Grid, Columns, Rows or Side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se ponen en mosaico al abrirse: Cuadrícula, Columnas, Filas o Lateral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは開くと自動でタイルされます。グリッド、カラム、ロウ、サイドに対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 열리면 격자, 열, 행, 측면으로 자동 타일됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口打开即自动平铺：网格、分栏、分行或侧栏。"
          }
        }
      }
    },
    "Your free trial has ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita ha terminado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料体験が終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 끝났습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用已结束。"
          }
        }
      }
    },
    "Your free trial has ended. Tessera won't tile until a license is active on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita ha terminado. Tessera no organizará ventanas hasta que haya una licencia activa en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料体験が終了しました。このMacでライセンスが有効になるまで、Tessera はタイルしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 끝났습니다. 이 Mac에서 라이선스가 활성화될 때까지 Tessera는 타일하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的免费试用已结束。在这台 Mac 上激活许可证之前，Tessera 不会平铺窗口。"
          }
        }
      }
    },
    "Your license and this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia y este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスとこのMac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스와 이 Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的许可证和这台 Mac。"
          }
        }
      }
    },
    "Your tiled apps aren't saved as a setup yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps en mosaico aún no están guardadas como configuración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル中のアプリはまだセットアップとして保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일된 앱이 아직 셋업으로 저장되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你平铺的应用尚未存储为布局方案。"
          }
        }
      }
    },
    "“%@” uses %@. Turn it off and use the keys here?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa %@. ¿Desactivarla y usar estas teclas aquí?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が %@ を使っています。そちらをオフにしてこのキーを使いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) %@을(를) 사용 중입니다. 그것을 끄고 이 키를 여기에 쓸까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”正在使用 %@。要关闭它并在这里使用这些按键吗？"
          }
        }
      }
    },
    "“%@” will be removed. Your apps aren't affected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará «%@». Tus apps no se verán afectadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が削除されます。アプリには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 삭제됩니다. 앱에는 영향이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将被移除。你的应用不受影响。"
          }
        }
      }
    },
    "“Needs more room” notices hidden for": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos de «Necesita más espacio» ocultos para"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「もっと広さが必要」の通知を隠しているアプリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“더 많은 공간 필요” 알림을 숨긴 앱"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏“需要更多空间”提示的应用"
          }
        }
      }
    }
  },
  "version": "1.0"
}
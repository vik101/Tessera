      }
    },
    "Too small for %ld windows in this layout": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado pequeña para %ld ventanas con esta disposición"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトでは %ld 個のウインドウには狭すぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이아웃에서 %ld개 윈도우에는 너무 작습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此布局下放不下 %ld 个窗口"
          }
        }
      }
    },
    "Tools for working on one thing, or sharing your screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herramientas para centrarte en una cosa o compartir tu pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの作業に集中したり、画面を共有したりするためのツール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 가지 일에 집중하거나 화면을 공유할 때 쓰는 도구."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注于一件事或共享屏幕的工具。"
          }
        }
      }
    },
    "Top": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上"
          }
        },
        "ko": {

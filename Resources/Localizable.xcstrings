    "Left to macOS. Use the menu bar panel, assign other keys, or pick another prefix.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservado para macOS. Usa el panel de la barra de menús, asigna otras teclas o elige otro prefijo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS に任せています。メニューバーのパネルを使うか、別のキーを割り当てるか、別のプレフィックスを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 맡겼습니다. 메뉴 막대 패널을 사용하거나, 다른 키를 지정하거나, 다른 접두 키를 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已留给 macOS。请使用菜单栏面板、分配其他按键，或选择其他前缀。"
          }
        }
      }
    },

    "Keep room for another app's dock or bar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja sitio para el dock o la barra de otra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリのDockやバー用にスペースを空けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 Dock이나 막대를 위한 공간을 남겨 둡니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为其他应用的程序坞或栏留出空间。"
          }
        }
      }
    },
    "Keep space free": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar espacio libre"
          }
        },
        "ja": {

    "None yet. Open a dialog that gets tiled by mistake and press %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna todavía. Abre un diálogo que se ponga en mosaico por error y pulsa %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。誤ってタイルされたダイアログを開いて %@ を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다. 실수로 타일된 대화상자를 열고 %@을(를) 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无。打开被误平铺的对话框，然后按 %@。"
          }
        }
      }
    },
    "Not now": {
      "localizations": {

    "Each screen has its own layout. Arrow keys move windows across.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pantalla tiene su propia disposición. Las flechas mueven ventanas entre pantallas."
          }

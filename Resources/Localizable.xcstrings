    "%@ needs more room on that screen. Try fewer windows or another layout.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita más espacio en esa pantalla. Prueba con menos ventanas u otra disposición."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はその画面でもっと広さが必要です。ウインドウ数を減らすか、別のレイアウトを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 그 화면에서 더 많은 공간이 필요합니다. 윈도우 수를 줄이거나 다른 레이아웃을 사용해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在该屏幕上需要更多空间。请减少窗口数量或换一种布局。"
          }
        }
      }
    },

    "It can't shrink enough to fit beside the other windows, so it floats in the middle.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encoge lo suficiente para caber junto a las demás ventanas, así que flota en el centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのウインドウの隣に収まるほど縮められないため、中央にフロートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 윈도우 옆에 들어갈 만큼 줄어들지 않아 가운데에 떠 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它无法缩小到能放在其他窗口旁边，因此在中间浮动。"
          }
        }
      }
    },
    "Keep it floating": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
